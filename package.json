{
  "name": "zhumora",
  "version": "0.2.4",
  "description": "An open-source AI agent that can code, automate tasks, and operate your computer.",
  "main": "./out/main/index.js",
  "author": "zhumora",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "node --no-warnings tests/history.test.ts && node --no-warnings tests/loopDetector.test.ts && node --no-warnings tests/multimodal.test.ts && node --no-warnings tests/truncation.test.ts",
    "preview": "electron-vite preview",
    "build:win": "electron-vite build && electron-builder --win --x64",
    "postinstall": "npx --yes cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ node node_modules/electron/install.js && npx --yes cross-env PLAYWRIGHT_BROWSERS_PATH=node_modules/playwright-core/.local-browsers npx playwright install chromium"
  },
  "config": {
    "electron_mirror": "https://npmmirror.com/mirrors/electron/"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^13.0.3",
    "gray-matter": "^4.0.3",
    "i18next": "^26.3.6",
    "lucide-react": "^1.31.0",
    "minimatch": "^10.2.6",
    "playwright": "^1.62.1",
    "react-i18next": "^17.0.11",
    "recharts": "^3.10.1",
    "robotjs": "^0.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "com.zhumora.app",
    "productName": "Zhumora",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "node_modules/playwright/**/*",
      "node_modules/playwright-core/**/*",
      "node_modules/@modelcontextprotocol/**/*",
      "node_modules/gray-matter/**/*",
      "node_modules/zod/**/*",
      "node_modules/minimatch/**/*",
      "!node_modules/**/{README,readme,CHANGELOG,changelog,LICENSE,license,*.md,*.map,*.ts}/**",
      "!node_modules/playwright-core/lib/opus/**",
      "!node_modules/playwright-core/lib/ffmpeg/**",
      "!node_modules/playwright-core/lib/transform/**",
      "!node_modules/**/test/**",
      "!node_modules/**/tests/**",
      "!node_modules/**/__tests__/**"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/robotjs/**/*",
      "node_modules/bindings/**/*",
      "node_modules/file-uri-to-path/**/*"
    ],
    "extraResources": [
      {
        "from": "node_modules/playwright-core/.local-browsers",
        "to": "browsers",
        "filter": [
          "**/*",
          "!chromium_headless_shell-*/**",
          "!winldd-*/**",
          "!.links/**",
          "!__dirlock"
        ]
      }
    ],
    "win": {
      "icon": "src/renderer/public/icon.ico",
      "target": [
        "nsis"
      ],
      "signExecutable": false
    }
  }
}
